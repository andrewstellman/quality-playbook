From e678f020de35a7f436d1b3ce735178e8d932dc3c Mon Sep 17 00:00:00 2001
From: Andrew Stellman <andrew@stellman.com>
Date: Tue, 29 Sep 2026 16:54:24 -0400
Subject: [PATCH] fix(v4): shallow-clone a constant .catch() value on every
 parse

A constant passed to .catch() was returned by reference, so pushing
onto one fallback array (or setting into one fallback Map) changed
what every later parse returned. .default() already shallow-clones
its static value on each read (#5173, #5855); constantCatch's thunk
now does the same, keeping the CONSTANT_CATCH tag and the compiled path.
---
 packages/zod/src/v4/classic/tests/catch.test.ts | 13 +++++++++++++
 packages/zod/src/v4/core/util.ts                |  4 ++--
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/packages/zod/src/v4/classic/tests/catch.test.ts b/packages/zod/src/v4/classic/tests/catch.test.ts
index dd53c441..eec3c45a 100644
--- a/packages/zod/src/v4/classic/tests/catch.test.ts
+++ b/packages/zod/src/v4/classic/tests/catch.test.ts
@@ -602,3 +602,16 @@ test("catch resolves the issues array on the async branch too", () => {
 
   return expect(inner.catch("FB2").safeParseAsync("abc")).resolves.toMatchObject({ success: true, data: "FB" });
 });
+
+test("a constant catch value is shallow-cloned per parse", () => {
+  const arr = z.array(z.string()).catch([]);
+  const a1 = arr.parse(1);
+  a1.push("leak");
+  const a2 = arr.parse(1);
+  expect(a1).not.toBe(a2);
+  expect(a2).toEqual([]);
+
+  const map = z.map(z.string(), z.number()).catch(new Map());
+  map.parse(1).set("k", 1);
+  expect(map.parse(1).size).toBe(0);
+});
diff --git a/packages/zod/src/v4/core/util.ts b/packages/zod/src/v4/core/util.ts
index b838ef9f..3a4cc14e 100644
--- a/packages/zod/src/v4/core/util.ts
+++ b/packages/zod/src/v4/core/util.ts
@@ -1272,9 +1272,9 @@ export function installLazyProp(inst: object, key: string, make: (self: any) =>
 /** Marks the thunk `_catch` synthesises for a constant catch value. `Function.length` cannot tell that thunk from a user callback — rest and defaulted parameters both report arity 0 — and a user callback reads `ctx.error`, whose issues only finalize correctly against the caller's per-parse error map. Provenance can say what arity cannot. A plain string key rather than `Symbol.for`, whose call at module scope no bundler can prove pure — the same shape that anchored `urlCanParse` into every build. */
 export const CONSTANT_CATCH = "~constantCatch";
 
-/** Wraps a constant catch value in a thunk tagged with {@link CONSTANT_CATCH}. */
+/** Wraps a constant catch value in a thunk tagged with {@link CONSTANT_CATCH}. Shallow-clones on every call, as the `.default()` getters do, so a caller mutating one fallback result cannot change the next. */
 export function constantCatch<T>(value: T): () => T {
-  const fn = () => value;
+  const fn = () => shallowClone(value);
   (fn as { [CONSTANT_CATCH]?: boolean })[CONSTANT_CATCH] = true;
   return fn;
 }
-- 

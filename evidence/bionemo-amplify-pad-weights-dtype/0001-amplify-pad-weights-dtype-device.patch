+from unittest.mock import MagicMock
+
+import torch
+
+from amplify.state_dict_convert import _pad_weights
+
+
+def test_pad_weights_preserves_dtype_and_device():
+    """_pad_weights must preserve the source tensor's dtype and device when padding.
+
+    Regression test: prior to this fix, the padding rows were created via a bare
+    `torch.zeros(num_padding_rows, source_embed.size(1))` with no dtype/device kwargs, so
+    padding a non-default-dtype (e.g. bf16) or non-CPU embedding silently upcast the result to
+    float32 (or raised a device-mismatch error on `torch.cat`). The sibling ESM2 implementation
+    (models/esm2/convert.py::_pad_weights) already passes dtype=/device=; this brings AMPLIFY's
+    copy in line with it.
+    """
+    ctx_mock = MagicMock()
+    ctx_mock.target.config.padded_vocab_size = 12
+
+    source_embed = torch.randn(10, 4, dtype=torch.bfloat16)
+
+    output = _pad_weights(ctx_mock, source_embed)
+
+    assert output.dtype == source_embed.dtype
+    assert output.device == source_embed.device
+    assert output.shape == (12, 4)
+    torch.testing.assert_close(output[:10].float(), source_embed.float())

index e9e722544..1921899c2 100644
--- a/CONTRIBUTORS.txt
+++ b/CONTRIBUTORS.txt
@@ -45,6 +45,7 @@ Andrei Ursulenko
 Andrej Antonov
 Andrew Leech
 Andrew Lytvyn
+Andrew Stellman
 Andrew Svetlov
 Andrew Top
 Andrew Zhou
diff --git a/aiohttp/streams.py b/aiohttp/streams.py
index cdd365cad..1d882d6a6 100644
--- a/aiohttp/streams.py
+++ b/aiohttp/streams.py
@@ -396,14 +396,23 @@ class StreamReader:
         while not_enough:
             while self._buffer and not_enough:
                 offset = self._buffer_offset
-                ichar = self._buffer[0].find(separator, offset) + 1
+                n = -1
+                if chunk and seplen > 1:
+                    # The separator may straddle data already read and this chunk.
+                    tail = chunk[1 - seplen :]
+                    head = self._buffer[0][offset : offset + seplen - 1]
+                    ichar = (tail + head).find(separator)
+                    if ichar != -1:
+                        n = ichar + seplen - len(tail)
+                if n == -1:
+                    ichar = self._buffer[0].find(separator, offset)
+                    if ichar != -1:
+                        n = ichar - offset + seplen
                 # Read from current offset to found separator or to the end.
-                data = self._read_nowait_chunk(
-                    ichar - offset + seplen - 1 if ichar else -1
-                )
+                data = self._read_nowait_chunk(n)
                 chunk += data
                 chunk_size += len(data)
-                if ichar:
+                if n != -1:
                     not_enough = False
 
                 if chunk_size > max_size:
diff --git a/tests/test_streams.py b/tests/test_streams.py
index eef6dfe24..5eb0daf52 100644
--- a/tests/test_streams.py
+++ b/tests/test_streams.py
@@ -504,6 +504,130 @@ class TestStreamReader:
         with pytest.raises(ValueError, match="Another exception"):
             await stream.readuntil(separator)
 
+    @pytest.mark.parametrize(
+        ("separator", "split"),
+        [
+            (separator, split)
+            for separator in (b"\r\n", b"\r\n\r\n", b"--xyz")
+            for split in range(len(separator) + 1)
+        ],
+    )
+    async def test_readuntil_separator_split_between_chunks(
+        self, separator: bytes, split: int
+    ) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"line1" + separator[:split])
+        stream.feed_data(separator[split:] + b"line2")
+        stream.feed_eof()
+
+        line = await stream.readuntil(separator)
+        assert b"line1" + separator == line
+        assert b"line2" == await stream.read()
+
+    @pytest.mark.parametrize("separator", [b"\r\n\r\n", b"--xyz"])
+    async def test_readuntil_separator_split_one_byte_per_chunk(
+        self, separator: bytes
+    ) -> None:
+        stream = self._make_one()
+        for byte in b"line1" + separator + b"line2":
+            stream.feed_data(bytes([byte]))
+        stream.feed_eof()
+
+        line = await stream.readuntil(separator)
+        assert b"line1" + separator == line
+        assert b"line2" == await stream.read()
+
+    @pytest.mark.parametrize(
+        ("chunks", "expected"),
+        [
+            ((b"xa", b"a", b"b", b"rest"), b"xaab"),
+            ((b"xaa", b"ab", b"rest"), b"xaaab"),
+            ((b"xa", b"aab", b"rest"), b"xaaab"),
+        ],
+    )
+    async def test_readuntil_separator_split_partial_overlap(
+        self, chunks: tuple[bytes, ...], expected: bytes
+    ) -> None:
+        stream = self._make_one()
+        for data in chunks:
+            stream.feed_data(data)
+        stream.feed_eof()
+
+        line = await stream.readuntil(b"aab")
+        assert expected == line
+        assert b"rest" == await stream.read()
+
+    async def test_readuntil_separator_split_with_false_start(self) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"a\r\n\r")
+        stream.feed_data(b"b\r\n\r")
+        stream.feed_data(b"\nrest")
+        stream.feed_eof()
+
+        line = await stream.readuntil(b"\r\n\r\n")
+        assert b"a\r\n\rb\r\n\r\n" == line
+        assert b"rest" == await stream.read()
+
+    @pytest.mark.parametrize("separator", [b"\r\n", b"\r\n\r\n"])
+    async def test_readuntil_separator_split_after_wait(self, separator: bytes) -> None:
+        loop = asyncio.get_running_loop()
+        stream = self._make_one()
+        stream.feed_data(b"line1" + separator[:1])
+        read_task = loop.create_task(stream.readuntil(separator))
+        for byte in separator[1:-1]:
+            for _ in range(3):
+                await asyncio.sleep(0)
+            assert stream._waiter is not None
+            stream.feed_data(bytes([byte]))
+
+        for _ in range(3):
+            await asyncio.sleep(0)
+        assert stream._waiter is not None
+        stream.feed_data(separator[-1:] + b"line2")
+        line = await asyncio.wait_for(read_task, timeout=1)
+        assert b"line1" + separator == line
+
+        stream.feed_eof()
+        assert b"line2" == await stream.read()
+
+    async def test_readuntil_separator_split_eof(self) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"line1\r\n\r")
+        stream.feed_data(b"\n")
+        stream.feed_eof()
+
+        line = await stream.readuntil(b"\r\n\r\n")
+        assert b"line1\r\n\r\n" == line
+        assert b"" == await stream.readuntil(b"\r\n\r\n")
+
+    async def test_readuntil_partial_separator_eof(self) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"line1\r")
+        stream.feed_data(b"\n\r")
+        stream.feed_eof()
+
+        line = await stream.readuntil(b"\r\n\r\n")
+        assert b"line1\r\n\r" == line
+
+    async def test_readuntil_separator_split_max_size(self) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"12\r")
+        stream.feed_data(b"\n3456")
+        stream.feed_eof()
+
+        line = await stream.readuntil(b"\r\n", max_size=4)
+        assert b"12\r\n" == line
+        assert b"3456" == await stream.read()
+
+    async def test_readuntil_separator_split_line_too_long(self) -> None:
+        stream = self._make_one()
+        stream.feed_data(b"123\r")
+        stream.feed_data(b"\nrest")
+        stream.feed_eof()
+
+        with pytest.raises(LineTooLong):
+            await stream.readuntil(b"\r\n", max_size=4)
+
     async def test_readexactly_zero_or_less(self) -> None:
         # Read exact number of bytes (zero or less).
         stream = self._make_one()

From 06be8da5a515da3d0b6849b2b1abb312f89e8196 Mon Sep 17 00:00:00 2001
From: Andrew Stellman <andrew@stellman.com>
Date: Tue, 20 Oct 2026 11:40:09 -0400
Subject: [PATCH] Apply dotted load_only/dump_only to Nested built from a
 Schema instance

---
 src/marshmallow/fields.py        |  9 +++++++++
 tests/test_bug_003_regression.py | 34 ++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 tests/test_bug_003_regression.py

diff --git a/src/marshmallow/fields.py b/src/marshmallow/fields.py
index 52af41d..174842e 100644
--- a/src/marshmallow/fields.py
+++ b/src/marshmallow/fields.py
@@ -592,6 +592,15 @@ class Nested(Field):
                     self._schema.exclude = set_class(self.exclude) | set_class(original)
                 if self.many is not None:
                     self._schema.many = self.many
+                for option_name in ("load_only", "dump_only"):
+                    nested_option = self._nested_normalized_option(option_name)
+                    if nested_option:
+                        setattr(
+                            self._schema,
+                            option_name,
+                            set_class(getattr(self._schema, option_name))
+                            | set_class(nested_option),
+                        )
                 self._schema._init_fields()
             else:
                 if isinstance(nested, type) and issubclass(nested, Schema):
diff --git a/tests/test_bug_003_regression.py b/tests/test_bug_003_regression.py
new file mode 100644
index 0000000..f7caa0e
--- /dev/null
+++ b/tests/test_bug_003_regression.py
@@ -0,0 +1,34 @@
+from __future__ import annotations
+
+import pytest
+
+from marshmallow import (
+    Schema,
+    ValidationError,
+    fields,
+    pre_load,
+    validate,
+    validates,
+    validates_schema,
+)
+
+
+def test_bug_003_instance_nested_honours_dotted_dump_only_and_load_only():
+    """[BUG-003, fields.py:580-595] The class/str/dict forms receive the parent's
+    dotted load_only/dump_only (fields.py:606-612); the instance form does not."""
+
+    class Inner(Schema):
+        a = fields.Int()
+        b = fields.Int()
+
+    class Outer(Schema):
+        by_class = fields.Nested(Inner)
+        by_instance = fields.Nested(Inner())
+
+    payload = {"by_class": {"a": 1, "b": 2}, "by_instance": {"a": 1, "b": 2}}
+    dumped = Outer(load_only=("by_class.b", "by_instance.b")).dump(payload)
+    assert dumped == {"by_class": {"a": 1}, "by_instance": {"a": 1}}
+
+    with pytest.raises(ValidationError) as exc:
+        Outer(dump_only=("by_class.b", "by_instance.b")).load(payload)
+    assert set(exc.value.messages) == {"by_class", "by_instance"}

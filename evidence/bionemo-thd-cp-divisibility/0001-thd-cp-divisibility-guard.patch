diff --git a/models/esm2/collator.py b/models/esm2/collator.py
index e83d719..8ed4a96 100644
--- a/models/esm2/collator.py
+++ b/models/esm2/collator.py
@@ -973,7 +973,16 @@ def _split_batch_by_cp_rank(
 
         # Calculate the chunk sizes for each sequence
         total_slices_of_any_sequence = 2 * cp_world_size
-        slice_sizes = (cu_seqlens_padded[1:] - cu_seqlens_padded[:-1]) // total_slices_of_any_sequence
+        seq_lengths = cu_seqlens_padded[1:] - cu_seqlens_padded[:-1]
+        remainders = seq_lengths % total_slices_of_any_sequence
+        if torch.any(remainders != 0):
+            bad_lengths = seq_lengths[remainders != 0].tolist()
+            raise ValueError(
+                f"Padded sequence length(s) {bad_lengths} must be divisible by "
+                f"{total_slices_of_any_sequence} (2 * cp_world_size) for THD context parallelism, "
+                "matching the guard already enforced by the BSHD branch (_process_tensor_bshd)."
+            )
+        slice_sizes = seq_lengths // total_slices_of_any_sequence
 
         # Ensure cu_seqlens_padded[-1] is a Python int, not a 0-dim tensor
         last_elem = cu_seqlens_padded[-1]

+import pytest
+import torch
+
+from collator import _split_batch_by_cp_rank
+
+
+def test_thd_cp_rejects_non_divisible_padded_length():
+    """The THD branch of _split_batch_by_cp_rank must reject padded sequence lengths that are
+    not divisible by 2 * cp_world_size, matching the guard the BSHD branch already has
+    (_process_tensor_bshd, "must be divisible by ... for BSHD context parallelism").
+
+    Regression test: previously, a non-divisible padded length silently floor-divided in
+    `slice_sizes = (cu_seqlens_padded[1:] - cu_seqlens_padded[:-1]) // total_slices_of_any_sequence`,
+    so the remainder tokens of that sequence were never selected by any CP rank -- silent
+    data loss instead of a loud failure.
+    """
+    cp_world_size = 2  # total_slices_of_any_sequence = 4
+    len_a, len_b = 8, 10  # len_b=10 is not divisible by 4
+    cu_seqlens_padded = torch.tensor([0, len_a, len_a + len_b], dtype=torch.int32)
+    total = len_a + len_b
+    input_ids = torch.arange(total, dtype=torch.long).unsqueeze(0)
+    labels = input_ids.clone()
+
+    with pytest.raises(ValueError, match="must be divisible by"):
+        _split_batch_by_cp_rank(
+            cu_seqlens_padded=cu_seqlens_padded,
+            input_ids_padded=input_ids,
+            labels_padded=labels,
+            qvk_format="thd",
+            cp_rank=0,
+            cp_world_size=cp_world_size,
+        )
+
+
+def test_thd_cp_accepts_divisible_padded_length_no_regression():
+    """Divisible padded lengths must continue to shard without error or dropped tokens."""
+    cp_world_size = 2  # total_slices_of_any_sequence = 4
+    len_a, len_b = 8, 8
+    cu_seqlens_padded = torch.tensor([0, len_a, len_a + len_b], dtype=torch.int32)
+    total = len_a + len_b
+    input_ids = torch.arange(total, dtype=torch.long).unsqueeze(0)
+    labels = input_ids.clone()
+
+    seen = set()
+    for cp_rank in range(cp_world_size):
+        sharded_ids, _ = _split_batch_by_cp_rank(
+            cu_seqlens_padded=cu_seqlens_padded,
+            input_ids_padded=input_ids,
+            labels_padded=labels,
+            qvk_format="thd",
+            cp_rank=cp_rank,
+            cp_world_size=cp_world_size,
+        )
+        seen.update(sharded_ids.flatten().tolist())
+
+    assert seen == set(range(total))

From: Quality Playbook v1.5.8 <quality-playbook>
Subject: [PATCH] BUG-003 regression test (xfail-strict, source-inspection)

Adds the BUG-003 regression test to quality/test_regression.py.
Strict-xfail: FAILs (XFAIL) on the buggy source, XPASSes once the matching
quality/patches/BUG-003-fix.patch is applied (remove the guard then).

--- /dev/null
+++ b/quality/test_regression.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+# Generated by Quality Playbook v1.5.8 — https://github.com/andrewstellman/quality-playbook
+# Author: Andrew Stellman · Date: 2026-06-19 · Project: linux-virtio
+#
+# Regression tests for the THREE bugs confirmed in Phase 3 (Code Review).
+# Same framework + style as quality/test_functional.py: source-inspection pytest
+# tests that read the actual driver source and assert on the presence/absence of
+# the exact code pattern each finding cites. This is the appropriate form for a
+# no-userspace-harness kernel target (SKILL.md File 7).
+#
+# Each test asserts the DESIRED CORRECT behavior, so it FAILS (XFAIL strict) on the
+# current buggy source and XPASSes — a strict failure that forces removing the guard —
+# once the corresponding quality/patches/BUG-NNN-fix.patch is applied.
+#
+# Tests are NOT marked run=False: they execute, read files, and string-match.
+# An inert test is the worst state (v1.3.18 BUG-004 regression).
+#
+# Run:  python3 -m pytest -xvs quality/test_regression.py
+
+import re
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parent.parent
+DRIVERS = REPO / "drivers" / "virtio"
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8", errors="ignore")
+
+
+def _func_body(source: str, signature_regex: str) -> str:
+    """Slice a C function from its signature to the first lone closing brace at
+    column 0 (mirrors quality/mechanical/verify.py and test_functional.py)."""
+    lines = source.splitlines()
+    start = None
+    for i, line in enumerate(lines):
+        if re.search(signature_regex, line):
+            start = i
+            break
+    assert start is not None, f"signature not found: {signature_regex}"
+    body = [lines[start]]
+    for line in lines[start + 1:]:
+        body.append(line)
+        if line == "}":
+            break
+    return "\n".join(body)
+
+
+class TestRegressionConfirmedBugs:
+    """One strict-xfail regression test per confirmed BUG-NNN."""
+
+    @pytest.mark.xfail(strict=True,
+        reason="BUG-003: vm_reset writes 0 to STATUS but never polls for a status read of 0 "
+               "(spec section 5) — unskip after applying quality/patches/BUG-003-fix.patch")
+    def test_bug003_vm_reset_polls_for_status_zero(self):
+        """BUG-003. Per virtio spec §5, after writing 0 to device status the driver MUST
+        wait for a read of device_status to return 0 (as vp_reset polls with
+        `while (vp_modern_get_status(mdev)) msleep(1)`). vm_reset does not poll."""
+        src = _read(DRIVERS / "virtio_mmio.c")
+        body = _func_body(src, r"static void vm_reset\(")
+        assert "VIRTIO_MMIO_STATUS" in body, "wrong function sliced"
+        # Desired correct behavior: a read-back poll loop on the status register.
+        has_poll = bool(re.search(r"while\s*\(.*readl\(.*VIRTIO_MMIO_STATUS", body)) or (
+            "while" in body and "readl" in body and "VIRTIO_MMIO_STATUS" in body)
+        assert has_poll, (
+            "vm_reset writes 0 to VIRTIO_MMIO_STATUS but has no `while (readl(...STATUS))` "
+            "wait-for-zero poll; spec §5 reset contract unmet (BUG-003)")
+
+
+if __name__ == "__main__":
+    import sys
+    sys.exit(pytest.main([__file__, "-v"]))

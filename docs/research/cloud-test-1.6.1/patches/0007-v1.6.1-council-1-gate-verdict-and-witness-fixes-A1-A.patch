+        self.assertIn("      - [alpha] x.json: broke\n", out)
+        self.assertIn("      - [beta] x.json: broke\n", out)
+        quality_gate._reset_counters()
+        quality_gate._new_bug_evidence("alpha")
+        out = _capture(quality_gate._emit_operator_verdict, records[:1], [],

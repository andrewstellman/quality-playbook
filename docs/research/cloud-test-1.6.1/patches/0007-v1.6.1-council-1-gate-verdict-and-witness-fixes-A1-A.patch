+_WARN_TAIL_RE = re.compile(r",\s*\d+\s+WARN\s*$")
+
+
+def total_without_warn(total: Optional[str]) -> Optional[str]:
+    """v1.6.1 [council-1]: the ``Total:`` line with its trailing
+    ``, N WARN`` part removed (WARN counts may legitimately change

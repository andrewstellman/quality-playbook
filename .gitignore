# Local skill installations (test copies, not the canonical source)
.github/

# Per-AI-tool skill installations created by bin/install_skill.py --ai-tool <tool>.
# QPB's canonical source-of-truth is bin/install_skill.py + .github/skills/ +
# bin/ + phase_prompts/ + references/ + agents/ + SKILL.md. The per-flavor
# installed directories are bootstrap artifacts from QPB auditing itself.
.claude/
.codex/
.cursor/
.continue/
.windsurf/
.cline/
.aider/

# install_skill.py::_ensure_sentinel_files() (v1.5.7 A-24) creates
# informal_docs/README.md as a sentinel for the gitignore template's
# negation rules. Adopters get the directory on install with the README
# explaining its purpose. QPB's own repo doesn't need to track its
# self-install copy. v1.6.x Requirements Review will activate this
# directory as a first-class source class (informal-spec role tag).
informal_docs/

# Test repos and run artifacts (used for playbook evaluation, not part of the skill)
repos/

# v1.5.7 149: harness run output (timestamped run folders) — the
# canonical output convention going forward. Never tracked.
harness_runs/
# legacy hyphen variant (older operators may still have it on disk)
harness-runs/

# docs_gathered/ is NEVER tracked — it contains AI chat history and other
# private reference material that must not be published. This rule applies at
# every depth (root-level bootstrap docs AND any repos/*/docs_gathered/).
docs_gathered/
**/docs_gathered/

# Tier 4 context and citable material — run-specific content (AI chats,
# design notes, retrospectives, plus adopter-supplied citable specs under
# cite/). Not tracked in the skill's own repo so QPB's reference_docs/
# stays a clean scaffold folder. Both .gitkeep sentinels are tracked so
# the folder exists after a fresh clone.
reference_docs/*
!reference_docs/.gitkeep
!reference_docs/cite/
reference_docs/cite/*
!reference_docs/cite/.gitkeep

# Bootstrap self-audit run history — TRACKED as project history:
#   quality/          self-audit output (proof of work)
#   previous_runs/    archived prior runs (iteration evidence)
#   control_prompts/  per-phase prompts sent to the runner
#   *-playbook-*.log  per-run logs
# cleanup_repo protects these paths from `git checkout .` via PROTECTED_PREFIXES,
# so they are safe to track.

# Python artifacts
__pycache__/
*.pyc
.venv/

# Parallel runner PID files (one per parent process — .run_pids.<pid>)
.run_pids
.run_pids.*

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~

# All review artifacts (Council, DOC_GATHERING_PROMPT, future artifact reviews
# of TOOLKIT.md / phase prompts / the rubric / etc.). Each reviewed artifact
# gets a subdir: reviews/council/, reviews/doc-gathering-prompt/, …
# Async harness review-requests/results live OUTSIDE QPB at
# v1.5.7_runner/reviews/ in the Cowork session folder — those are not
# affected by this rule.
reviews/

# Runner folder — live coordination mailboxes are ignored...
runner/*
# ...except the committed QPB skill-development worker runner (bootstrap + instruction/output/review record)
!runner/quality-playbook/
# ...minus its per-cycle churn
runner/quality-playbook/STATUS.md
runner/quality-playbook/STOP
runner/quality-playbook/.claude/

# Test folder
testing/

# Pattern discovery working files
pattern-discovery/
qpb-bootstrap-iter-remaining.log
qpb-*.log

# Local cycle helper scripts (one-off serial runners; not part of the skill)
run-serial.sh

# Metrics files 
metrics/bootstrap_recall/
metrics/cross_version_trends/
metrics/*/.backup-*/


# v1.5.7 089u — pip channel build artifacts
quality_playbook_cli/_bundle/
build/
dist/
*.egg-info/
quality-playbook-*.tgz

# v1.5.10 repo-hygiene (instr 052): committed run-output + orphaned partial copies
# removed from tracking (git history retains them; no rewrite). quality/ is QPB's
# own self-run OUTPUT dir; quality/audits/ is carved out (read by
# test_192_audit_log.py + test_schemas_audit_191.py with no skip guard).
quality/*
!quality/audits/
/previous_runs/
/spike/
.github/skills/quality_gate/
metrics/classifier_verification.log
